{
  "name": "pananames-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for Pananames contacts and domain cart workflows",
  "scripts": {
    "test": "playwright test",
    "test:contacts": "playwright test tests/contacts.spec.ts",
    "test:domains": "playwright test tests/single-domain.spec.ts tests/multiple-domains.spec.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.1",
    "typescript": "^5.9.2"
  }
}
